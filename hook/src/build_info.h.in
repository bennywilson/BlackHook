// baking in a placeholder that would read as a real commit in the manifest.

namespace mv
{
inline constexpr const char* kBuildGitCommit = "@MV_GIT_COMMIT@";
// When CMake configured this build, UTC, ISO 8601. Not when the commit was
// made - when THIS BINARY was configured, which is what "was this DLL built
// from what I think it was built from" actually needs.
inline constexpr const char* kBuildConfiguredUtc = "@MV_BUILD_UTC@";
// The repo's temp/ directory, forward slashes. Logs go to <root>/logs/, the
